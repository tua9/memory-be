# Chỉ chứa tên biến và giá trị mẫu; không commit giá trị thật.
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173
MONGODB_CONNECTION_STRING=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Gửi email (link đổi mật khẩu). Thiếu SMTP_HOST/SMTP_USER/SMTP_PASS thì API gửi link trả lỗi 503.
# CLIENT_URL cũng là gốc của link trong email nên phải là địa chỉ frontend thật.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Memio

# Số proxy đứng trước server (vd. 1 khi deploy sau Render/Nginx) để giới hạn request theo IP đọc đúng IP.
# Bỏ trống khi chạy trực tiếp không qua proxy.
TRUST_PROXY=

